# VideoDB (required) — ingest, index, search, voice, timeline
VIDEO_DB_API_KEY=your_videodb_api_key

# OpenAI (required for AI chapter planning; also used by openai_tts voice provider)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# YouTube Data API v3 — video discovery (optional)
YOUTUBE_API_KEY=

# Backend
CONTINUUM_HOST=0.0.0.0
CONTINUUM_PORT=8000
CONTINUUM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pipeline defaults
CONTINUUM_MAX_SOURCE_VIDEOS=8
CONTINUUM_TARGET_DURATION_SEC=300
CONTINUUM_COLLECTION_PREFIX=continuum

# ---------------------------------------------------------------------------
# Voice generation (one flag — see README "Voice generation")
# ---------------------------------------------------------------------------
# openai_tts          — OpenAI TTS, uploads audio to VideoDB (best for judges / no VideoDB voice credits)
# videodb_sandbox     — OmniVoice on VideoDB Sandbox compute (our primary hackathon demo path)
# videodb_default     — VideoDB hosted Default voice (plan quota applies)
CONTINUUM_VOICE_PROVIDER=openai_tts

# openai_tts settings (recommended for evaluation)
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_SPEED=1.0

# videodb_default settings
VIDEO_DB_DEFAULT_VOICE_NAME=Default

# videodb_sandbox settings (create sandbox: backend\.venv\Scripts\python.exe ..\scripts\create_sandbox.py)
# CONTINUUM_VOICE_PROVIDER=videodb_sandbox
# VIDEO_DB_SANDBOX_ID=
# VIDEO_DB_SANDBOX_AUTO_CREATE=0
# VIDEO_DB_SANDBOX_TIER=small
# VIDEO_DB_VOICE_INSTRUCTIONS=Clear documentary narrator, moderate pace

# Legacy (optional): VIDEO_DB_USE_SANDBOX_VOICE=1 maps to videodb_sandbox if CONTINUUM_VOICE_PROVIDER is unset

# Console performance (Windows: minimized terminal slows tqdm + log spam)
# CONTINUUM_DISABLE_TQDM=1
# CONTINUUM_QUIET_CONSOLE=1
# CONTINUUM_LOG_TO_FILE=1
# CONTINUUM_SHOW_PROGRESS=1
