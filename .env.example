# VideoDB (required) — ingest, index, search, voice, timeline
VIDEO_DB_API_KEY=your_videodb_api_key

# OpenAI (required for AI chapter planning; rule-based fallback if empty)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# YouTube Data API v3 — video discovery (optional; demo topics work without it)
YOUTUBE_API_KEY=

# Backend
CONTINUUM_HOST=0.0.0.0
CONTINUUM_PORT=8000
CONTINUUM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pipeline defaults
CONTINUUM_MAX_SOURCE_VIDEOS=8
CONTINUUM_TARGET_DURATION_SEC=300
CONTINUUM_COLLECTION_PREFIX=continuum

# Console performance (Windows: minimized terminal slows tqdm + log spam)
# CONTINUUM_DISABLE_TQDM=1
# CONTINUUM_QUIET_CONSOLE=1
# CONTINUUM_LOG_TO_FILE=1
# CONTINUUM_SHOW_PROGRESS=1
